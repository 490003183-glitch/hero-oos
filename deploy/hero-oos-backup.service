[Unit]
Description=Back up Hero OOS with SQLite online backup
After=hero-oos.service
Requires=hero-oos.service

[Service]
Type=oneshot
User=hero-oos
Group=hero-oos
UMask=0077
ExecStartPre=/usr/bin/curl --fail --silent --retry 6 --retry-connrefused --retry-delay 2 --max-time 10 http://127.0.0.1:4180/health
ExecStart=/opt/hero-oos/venv/bin/python /opt/hero-oos/daily-backup.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hero-oos
PrivateTmp=true
TimeoutStartSec=300
